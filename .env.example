APP_NAME="DTR System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (local default sqlite; production: Neon PostgreSQL) ---
DB_CONNECTION=sqlite
# Neon example:
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Free / local: database or sync. Paid scale: redis.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (optional; paid on most hosts — leave unused on free tier)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS (admin static site origin; comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Photos: local public disk OR Cloudflare R2 (S3-compatible) ---
ATTENDANCE_PHOTO_DISK=public
# R2 example:
# ATTENDANCE_PHOTO_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=dtr-photos
# AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# Attendance
# Free tier: false runs face check inline (no worker). Paid: true + queue worker.
ATTENDANCE_ASYNC_FACE=false
ATTENDANCE_EMPLOYEE_LOCK_SECONDS=15
ATTENDANCE_SYNC_MAX_RECORDS=100
ATTENDANCE_SYNC_MAX_WITH_PHOTOS=5

FACE_VERIFICATION_PROVIDER=mock
TELESCOPE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
