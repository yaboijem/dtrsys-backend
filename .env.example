APP_NAME="DTR System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dtrsys
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Free / local: database or sync. Paid scale: redis.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (optional; paid on most hosts — leave unused on free tier)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS (admin static site origin; comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Photos ---
# Photos stored in MySQL when set to database (LONGTEXT, no object storage)
# Local: public | Optional later: s3 (R2/S3-compatible)
ATTENDANCE_PHOTO_DISK=database
# ATTENDANCE_PHOTO_DISK=public
# ATTENDANCE_PHOTO_DISK=s3
# AWS_* only needed for s3/R2


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# Attendance
ATTENDANCE_EMPLOYEE_LOCK_SECONDS=15
ATTENDANCE_SYNC_MAX_RECORDS=100
ATTENDANCE_SYNC_MAX_WITH_PHOTOS=5

TELESCOPE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

NOMINATIM_VERIFY_SSL=true

# Web Push (generate with: php artisan tinker --execute="dump(Minishlink\WebPush\VAPID::createVapidKeys());")
VAPID_SUBJECT=mailto:admin@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google sign-in (portal). Web OAuth client id. No secret.
GOOGLE_CLIENT_ID=
