APP_NAME="DTR System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dtrsys
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Free / local: database or sync. Paid scale: redis.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (optional; paid on most hosts — leave unused on free tier)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reverse proxy IPs. Use * only when the app is not reachable except through the proxy.
TRUSTED_PROXIES=*

# Sanctum token lifetime in minutes. Browser sessions use an httpOnly cookie of the same length.
SANCTUM_EXPIRATION=720

# --- CORS (admin origin; comma-separated; credentials are required) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Photos ---
# local = private disk (storage/app/private). database = MySQL LONGTEXT. s3 = private object storage.
ATTENDANCE_PHOTO_DISK=local
# ATTENDANCE_PHOTO_DISK=public
# ATTENDANCE_PHOTO_DISK=s3
# AWS_* only needed for s3/R2


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# Attendance
ATTENDANCE_EMPLOYEE_LOCK_SECONDS=15
OPEN_SESSION_LOOKBACK_DAYS=30

# Default geofence radius (meters) for a newly submitted home location.
GPS_HOME_RADIUS_METERS=200

TELESCOPE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

NOMINATIM_VERIFY_SSL=true

# Web Push (generate with: php artisan tinker --execute="dump(Minishlink\WebPush\VAPID::createVapidKeys());")
VAPID_SUBJECT=mailto:admin@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google sign-in (portal). Web OAuth client id. No secret.
GOOGLE_CLIENT_ID=
